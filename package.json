  },
  "keywords": [
    "llm",
    "vram",
    "gpu",
    "kv-cache",
    "deepseek",
    "mla",
    "gqa",
    "local-llm",
    "rtx-5090",
    "quantization"
  ],
  "homepage": "https://global-utils.com/en/gpu-vram-calculator",
